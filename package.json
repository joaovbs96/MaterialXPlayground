{
  "name": "materialx-playground",
  "displayName": "MaterialX Playground",
  "description": "View .mtlx files in the MaterialX Playground web app: view MaterialX documents in a 3D viewer, or edit node graphs in a graph editor. Open USD stages in the USD Scene Viewer.",
  "version": "2026.8.11",
  "publisher": "MaterialXPlayground",
  "preview": true,
  "license": "Apache-2.0",
  "private": true,
  "icon": "images/icon.png",
  "homepage": "https://joaovbs96.github.io/MaterialXPlayground/#!vscode",
  "bugs": {
    "url": "https://github.com/joaovbs96/MaterialXPlayground/issues"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.12"
  },
  "main": "vscode_extension/src/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaovbs96/MaterialXPlayground"
  },
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the playground does not open automatically; open it with the MaterialX Playground: Open MaterialX Document command; validation, hovers and the node library work normally."
    }
  },
  "scripts": {
    "setup:ktx": "node scripts/setup-ktx.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:offline": "node scripts/vendor.mjs --with-materialx",
    "vendor:versions": "node scripts/fetch-mtlx-versions.mjs",
    "build": "node scripts/build.mjs",
    "build:vendor": "node scripts/build.mjs vendor",
    "build:nodelib": "node scripts/build.mjs nodelib",
    "build:embed": "node scripts/build.mjs embed",
    "build:embeddocs": "node scripts/build.mjs embeddocs",
    "build:tutorials": "node scripts/build.mjs tutorials",
    "build:buildid": "node scripts/build.mjs buildid",
    "build:webview": "node scripts/build.mjs webview",
    "check": "node scripts/build.mjs --check",
    "test:embed": "playwright test",
    "test:embed:smoke": "playwright test --grep @smoke",
    "test:vscode": "playwright test --config=playwright.vscode.config.mjs",
    "gallery:manifest": "node scripts/build-gallery.mjs",
    "gallery:thumbs": "node scripts/gallery-shots.mjs",
    "gallery:data": "npm run gallery:manifest && npm run gallery:thumbs",
    "electron:dev": "node electron/scripts/dev.mjs",
    "electron:pack": "node electron/scripts/pack.mjs",
    "test:vscode-host": "node tests/vscode-host/run.mjs",
    "test:vscode-smoke": "node tests/vscode-host/smoke.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "7.26.10",
    "@highlightjs/cdn-assets": "11.9.0",
    "@playwright/test": "1.62.1",
    "dagre": "0.8.5",
    "jszip": "3.10.1",
    "katex": "0.16.47",
    "marked": "18.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reactflow": "11.11.4",
    "three": "0.128.0",
    "three-147": "npm:three@0.147.0",
    "utif": "3.1.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "materialx",
    "usd",
    "usdmtlx",
    "pixar",
    "openusd",
    "vfx",
    "3d",
    "graphics",
    "node graph",
    "shader",
    "shader graph",
    "material",
    "material graph",
    "materialx playground",
    "materialx viewer",
    "materialx editor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mtlx",
        "extensions": [
          ".mtlx"
        ],
        "aliases": [
          "MaterialX",
          "mtlx"
        ],
        "configuration": "./vscode_extension/language/mtlx.language-configuration.json",
        "icon": {
          "light": "./vscode_extension/media/mtlx-file-light.svg",
          "dark": "./vscode_extension/media/mtlx-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mtlx",
        "scopeName": "text.mtlx",
        "path": "./vscode_extension/language/mtlx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mtlx",
        "path": "./vscode_extension/language/mtlx.snippets.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "materialxPlayground.editor",
        "displayName": "MaterialX Playground",
        "selector": [
          {
            "filenamePattern": "*.mtlx"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "materialxPlayground.sceneViewer",
        "displayName": "MaterialX Playground: USD Scene Viewer",
        "selector": [
          {
            "filenamePattern": "*.usd"
          },
          {
            "filenamePattern": "*.usda"
          },
          {
            "filenamePattern": "*.usdc"
          },
          {
            "filenamePattern": "*.usdz"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "materialxPlayground.openScene",
        "title": "MaterialX Playground: Open in USD Scene Viewer",
        "icon": "$(open-preview)",
        "enablement": "resourceExtname =~ /^\\.(usd|usda|usdc|usdz)$/i"
      },
      {
        "command": "materialxPlayground.open",
        "title": "MaterialX Playground: Open MaterialX Document",
        "icon": "$(open-preview)",
        "enablement": "resourceExtname == .mtlx"
      },
      {
        "command": "materialxPlayground.openDocs",
        "title": "MaterialX Playground: Open Node Library Documentation"
      },
      {
        "command": "materialxPlayground.saveGraph",
        "title": "MaterialX Playground: Save Node Graph to File"
      },
      {
        "command": "materialxPlayground.undoGraph",
        "title": "MaterialX Playground: Undo Node Graph Edit"
      },
      {
        "command": "materialxPlayground.redoGraph",
        "title": "MaterialX Playground: Redo Node Graph Edit"
      },
      {
        "command": "materialxPlayground.newFromExample",
        "title": "MaterialX Playground: New Material from Example"
      }
    ],
    "keybindings": [
      {
        "command": "materialxPlayground.saveGraph",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'materialxPlayground.editor'"
      },
      {
        "command": "materialxPlayground.undoGraph",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'materialxPlayground.editor'"
      },
      {
        "command": "materialxPlayground.redoGraph",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'materialxPlayground.editor'"
      },
      {
        "command": "materialxPlayground.redoGraph",
        "key": "ctrl+y",
        "when": "activeCustomEditorId == 'materialxPlayground.editor'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "materialxPlayground.open",
          "when": "resourceExtname == .mtlx && activeCustomEditorId != 'materialxPlayground.editor'",
          "group": "navigation"
        },
        {
          "command": "materialxPlayground.openScene",
          "when": "resourceExtname =~ /^\\.(usd|usda|usdc|usdz)$/i && activeCustomEditorId != 'materialxPlayground.sceneViewer'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "materialxPlayground.open",
          "when": "resourceExtname == .mtlx"
        },
        {
          "command": "materialxPlayground.openScene",
          "when": "resourceExtname =~ /^\\.(usd|usda|usdc|usdz)$/i"
        },
        {
          "command": "materialxPlayground.openDocs"
        },
        {
          "command": "materialxPlayground.newFromExample"
        }
      ],
      "explorer/context": [
        {
          "command": "materialxPlayground.open",
          "when": "resourceExtname == .mtlx",
          "group": "materialxPlayground"
        },
        {
          "command": "materialxPlayground.openDocs",
          "when": "resourceExtname == .mtlx",
          "group": "materialxPlayground"
        },
        {
          "command": "materialxPlayground.newFromExample",
          "when": "explorerResourceIsFolder",
          "group": "materialxPlayground"
        },
        {
          "command": "materialxPlayground.openScene",
          "when": "resourceExtname =~ /^\\.(usd|usda|usdc|usdz)$/i",
          "group": "materialxPlayground"
        }
      ],
      "editor/title/context": [
        {
          "command": "materialxPlayground.openScene",
          "when": "resourceExtname =~ /^\\.(usd|usda|usdc|usdz)$/i",
          "group": "materialxPlayground"
        },
        {
          "command": "materialxPlayground.open",
          "when": "resourceExtname == .mtlx",
          "group": "materialxPlayground"
        },
        {
          "command": "materialxPlayground.openDocs",
          "when": "resourceExtname == .mtlx",
          "group": "materialxPlayground"
        }
      ]
    },
    "configuration": {
      "title": "MaterialX Playground",
      "properties": {
        "materialxPlayground.defaultView": {
          "type": "string",
          "enum": [
            "viewer",
            "graph"
          ],
          "default": "graph",
          "description": "Which MaterialX Playground view (the Material Viewer or the Node Graph Editor) is shown first when a .mtlx file is opened with the MaterialX Playground custom editor. The document is loaded into both views either way; this setting only picks which one is initially visible. Use the header nav to switch to the other."
        },
        "materialxPlayground.openBehavior": {
          "type": "string",
          "enum": [
            "splitRight",
            "sameGroup"
          ],
          "default": "splitRight",
          "enumDescriptions": [
            "Open the playground beside the text editor for the same file, reusing an existing right-hand editor group on repeat opens instead of splitting again every time.",
            "Open the playground in the active editor group (the previous behavior)."
          ],
          "description": "Where the MaterialX Playground opens when a text editor for the same .mtlx file is visible: \"splitRight\" opens it beside that editor, reusing an existing right-hand group rather than creating a new split each time; \"sameGroup\" opens it in the active editor group, replacing (or reusing) whatever tab is already there. This is the previous behavior."
        },
        "materialxPlayground.autoOpenPlayground": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the MaterialX Playground beside the text editor whenever a .mtlx file is opened. Triggers once per file open; closing the playground won't re-trigger it until the file itself is closed and reopened."
        },
        "materialxPlayground.autoOpenSceneViewer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the USD Scene Viewer for a USD scene file (.usd, .usda, .usdc, .usdz). A text-editable file (.usda, or .usd that opens as text) opens the viewer beside the text editor; a binary file (.usdc, .usdz, or .usd that VS Code cannot show as text) has its editor tab replaced by the viewer. Triggers once per file open; closing the viewer won't re-trigger it until the file itself is closed and reopened."
        },
        "materialx.defaultView": {
          "type": "string",
          "enum": [
            "viewer",
            "graph"
          ],
          "default": "graph",
          "description": "Deprecated: renamed to materialxPlayground.defaultView.",
          "deprecationMessage": "Renamed to materialxPlayground.defaultView. This setting still works, but will be removed in a future release.",
          "markdownDeprecationMessage": "Renamed to `materialxPlayground.defaultView`. This setting still works, but will be removed in a future release."
        },
        "materialx.openBehavior": {
          "type": "string",
          "enum": [
            "splitRight",
            "sameGroup"
          ],
          "default": "splitRight",
          "description": "Deprecated: renamed to materialxPlayground.openBehavior.",
          "deprecationMessage": "Renamed to materialxPlayground.openBehavior. This setting still works, but will be removed in a future release.",
          "markdownDeprecationMessage": "Renamed to `materialxPlayground.openBehavior`. This setting still works, but will be removed in a future release."
        },
        "materialx.autoOpenPlayground": {
          "type": "boolean",
          "default": true,
          "description": "Deprecated: renamed to materialxPlayground.autoOpenPlayground.",
          "deprecationMessage": "Renamed to materialxPlayground.autoOpenPlayground. This setting still works, but will be removed in a future release.",
          "markdownDeprecationMessage": "Renamed to `materialxPlayground.autoOpenPlayground`. This setting still works, but will be removed in a future release."
        }
      }
    }
  }
}
