<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="SR_MatA" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.1, 0.1" />
    <input name="specular_roughness" type="float" value="0.3" />
  </standard_surface>
  <surfacematerial name="MatA" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_MatA" />
  </surfacematerial>

  <standard_surface name="SR_MatB" type="surfaceshader">
    <input name="base_color" type="color3" value="0.1, 0.2, 0.8" />
    <input name="specular_roughness" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="MatB" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_MatB" />
  </surfacematerial>
</materialx>
