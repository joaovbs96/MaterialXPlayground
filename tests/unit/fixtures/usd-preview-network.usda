#usda 1.0
def Material "M"
{
    token outputs:surface.connect = </M/Surf.outputs:surface>
    def Shader "Surf"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </M/Tex.outputs:rgb>
        float inputs:roughness.connect = </M/Tex.outputs:g>
        float inputs:opacity.connect = </M/Tex.outputs:a>
        normal3f inputs:normal.connect = </M/Nrm.outputs:rgb>
        color3f inputs:emissiveColor = (1, 0, 0)
        float inputs:metallic = 0.5
        int inputs:useSpecularWorkflow = 0
        float inputs:ior = 1.5
        token outputs:surface
    }
    def Shader "Tex"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @tex.png@ (
            colorSpace = "sRGB"
        )
        float2 inputs:st.connect = </M/Xf.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "clamp"
        float4 inputs:scale = (1, 1, 1, 1)
        float4 inputs:bias = (0, 0, 0, 0)
        float3 outputs:rgb
        float outputs:g
        float outputs:a
    }
    def Shader "Nrm"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @n.png@
        float2 inputs:st.connect = </M/Uv.outputs:result>
        float3 outputs:rgb
    }
    def Shader "Xf"
    {
        uniform token info:id = "UsdTransform2d"
        float2 inputs:in.connect = </M/Uv.outputs:result>
        float inputs:rotation = 10
        float2 inputs:scale = (2, 2)
        float2 inputs:translation = (0.1, 0.1)
        float2 outputs:result
    }
    def Shader "Uv"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }
}
