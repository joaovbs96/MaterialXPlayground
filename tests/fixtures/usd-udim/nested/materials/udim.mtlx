<?xml version="1.0"?>
<materialx version="1.39">
  <image name="udim_color" type="color3">
    <input name="file" type="filename" value="../../textures/udim.&lt;UDIM&gt;.png" />
  </image>
  <standard_surface name="udim_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="udim_color" />
    <input name="specular_roughness" type="float" value="1.0" />
  </standard_surface>
  <surfacematerial name="udim_material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="udim_surface" />
  </surfacematerial>
</materialx>
