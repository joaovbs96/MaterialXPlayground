#usda 1.0
(
    defaultPrim = "Asset"
    upAxis = "Y"
)

def Xform "Asset" {
    double3 xformOp:rotateXYZ = (0.0, 0.0, 8.0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Scope "Looks" {
        def Material "UdimMaterial" (
            references = @materials/udim.mtlx@</MaterialX/Materials/udim_material>
        ) {}
    }

    def Mesh "UdimQuad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        int[] faceVertexCounts = [4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 5, 6, 7]
        point3f[] points = [
            (-1.0, -0.75, 0.0), (-0.05, -0.75, 0.0), (-0.05, 0.75, 0.0), (-1.0, 0.75, 0.0),
            ( 0.05, -0.75, 0.0), ( 1.0, -0.75, 0.0), ( 1.0, 0.75, 0.0), ( 0.05, 0.75, 0.0)
        ]
        rel material:binding = </Asset/Looks/UdimMaterial>
        texCoord2f[] primvars:st = [
            (0.10, 0.10), (0.90, 0.10), (0.90, 0.90), (0.10, 0.90),
            (0.10, 1.10), (0.90, 1.10), (0.90, 1.90), (0.10, 1.90)
        ] ( interpolation = "faceVarying" )
        int[] primvars:st:indices = [0, 1, 2, 3, 4, 5, 6, 7]
        def GeomSubset "SecondTile" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            uniform token familyType = "nonOverlapping"
            int[] indices = [1]
            rel material:binding = </Asset/Looks/UdimMaterial>
        }
    }

    def Xform "ReuseTransform" {
        double3 xformOp:translate = (0.0, -1.8, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "ReuseTriangle" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(-0.4, -0.3, 0.0), (0.4, -0.3, 0.0), (0.0, 0.4, 0.0)]
            rel material:binding = </Asset/Looks/UdimMaterial>
            texCoord2f[] primvars:st = [(0.2, 0.2), (0.8, 0.2), (0.5, 0.8)] ( interpolation = "faceVarying" )
            int[] primvars:st:indices = [0, 1, 2]
        }
    }
}
