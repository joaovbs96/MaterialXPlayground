<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="glossy_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="specular_roughness" type="float" value="0.05" />
  </standard_surface>
  <surfacematerial name="glossy_material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="glossy_surface" />
  </surfacematerial>
</materialx>
