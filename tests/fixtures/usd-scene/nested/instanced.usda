#usda 1.0
(
    defaultPrim = "InstancedAsset"
    upAxis = "Y"
)

def Xform "InstancedAsset" {
    double3 xformOp:translate = (1.0, 2.0, 0.5)
    double3 xformOp:rotateXYZ = (0.0, 0.0, 30.0)
    double3 xformOp:scale = (1.5, 0.75, 1.0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def Scope "Looks" {
        def Material "RedMaterial" (
            references = @materials/red.mtlx@</MaterialX/Materials/red_material>
        ) {
        }
        def Material "BlueMaterial" (
            references = @materials/blue.mtlx@</MaterialX/Materials/blue_material>
        ) {
        }
    }

    def PointInstancer "Instances" {
        point3f[] positions = [(-0.75, 0.0, 0.0), (0.75, 0.0, 0.0)]
        quath[] orientations = [(1, 0, 0, 0), (0.9659258, 0, 0, 0.258819)]
        float3[] scales = [(1, 1, 1), (0.6, 0.6, 0.6)]
        int[] protoIndices = [0, 0]
        rel prototypes = </InstancedAsset/Instances/Prototype>

        def Xform "Prototype" (
            references = @prototype.usda@</Prototype>
        ) {
        }
    }
}
