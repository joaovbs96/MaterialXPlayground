#usda 1.0
(
    defaultPrim = "Prototype"
    upAxis = "Y"
)

def Xform "Prototype" {
    def Mesh "RedQuad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [
            (-0.5, -0.5, 0.0), (0.0, -0.5, 0.0), (0.0, 0.5, 0.0), (-0.5, 0.5, 0.0)
        ]
        rel material:binding = </Prototype/RedMaterial>
    }
    def Mesh "BlueQuad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    ) {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0.0, -0.5, 0.0), (0.5, -0.5, 0.0), (0.5, 0.5, 0.0), (0.0, 0.5, 0.0)]
        rel material:binding = </Prototype/BlueMaterial>
    }
    def Material "RedMaterial" (
        references = @materials/red.mtlx@</MaterialX/Materials/red_material>
    ) {
    }
    def Material "BlueMaterial" (
        references = @materials/blue.mtlx@</MaterialX/Materials/blue_material>
    ) {
    }
}
