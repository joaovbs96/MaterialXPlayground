<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <open_pbr_surface name="opacity_surface" type="surfaceshader">
    <input name="base_weight" type="float" value="1" />
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="specular_weight" type="float" value="1" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="transmission_weight" type="float" value="0" />
    <input name="geometry_opacity" type="float" value="0.5" />
    <input name="geometry_thin_walled" type="boolean" value="false" />
  </open_pbr_surface>
  <surfacematerial name="opacity" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="opacity_surface" />
  </surfacematerial>
</materialx>
