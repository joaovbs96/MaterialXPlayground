#usda 1.0
(
    defaultPrim = "InstancedAsset"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "InstancedAsset" {
    double3 xformOp:translate = (1.0, 2.0, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def PointInstancer "Instances" {
        point3f[] positions = [(-0.75, 0.0, 0.0), (0.75, 0.0, 0.0)]
        quath[] orientations = [(1, 0, 0, 0), (0.9659258, 0, 0, 0.258819)]
        float3[] scales = [(1, 1, 1), (0.6, 0.6, 0.6)]
        int[] protoIndices = [0, 0]
        rel prototypes = </InstancedAsset/Instances/Prototype>

        def Xform "Prototype" (
            references = @prototype.usda@</Prototype>
        ) {
        }
    }
}
