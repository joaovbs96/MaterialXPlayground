<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- set pageTitle = (title + " | " + site.title) if title else site.title %}
    {%- set pageDescription = description or site.description %}
    {%- set canonical = page.url | absUrl %}
    {%- set ogImage = (image or site.ogImage) | siteAbsUrl %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ canonical }}">
    <link rel="icon" type="image/x-icon" href="{{ appRoot }}favicon.ico">
    <link rel="apple-touch-icon" href="{{ appRoot }}apple-touch-icon.png">
    <meta name="theme-color" content="#111827">
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/feed.xml' | absUrl }}">

    <meta property="og:site_name" content="{{ site.appName }}">
    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:type" content="{{ 'article' if ogType == 'article' else 'website' }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:image" content="{{ ogImage }}">
    {%- if not image %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {%- endif %}
    <meta property="og:image:alt" content="{{ imageAlt or (title or site.title) }}">
    {%- if ogType == 'article' %}
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    {%- if updated %}<meta property="article:modified_time" content="{{ updated | isoDate }}">{% endif %}
    {%- for tag in tags | userTags %}
    <meta property="article:tag" content="{{ tag }}">
    {%- endfor %}
    {%- endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.title }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ ogImage }}">
    {%- if ogType == 'article' %}
    {%- set jsonLd = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": pageDescription,
        "datePublished": page.date | isoDate,
        "dateModified": (updated or page.date) | isoDate,
        "author": { "@type": "Person", "name": author or site.author },
        "image": ogImage,
        "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
        "publisher": { "@type": "Organization", "name": site.appName, "url": site.siteUrl, "logo": { "@type": "ImageObject", "url": site.siteUrl + "apple-touch-icon.png" } }
    } %}
    <script type="application/ld+json">{{ jsonLd | jsonScript | safe }}</script>
    {%- endif %}

    <!-- Subsite globals first: js/site-header.js reads them to build app-root links. -->
    <script>window.__MTLX_SUBSITE__ = 'blog'; window.__MTLX_APP_ROOT__ = {{ appRoot | jsonScript | safe }};</script>
    <script src="{{ appRoot }}js/shared/theme-tokens.js"></script>
    <script src="{{ appRoot }}js/shared/theme.js"></script>
    <link rel="stylesheet" href="{{ appRoot }}js/gen/theme-tokens.css">
    <link rel="stylesheet" href="{{ appRoot }}js/site-tokens.css">
    <link rel="stylesheet" href="{{ appRoot }}js/site-header.css">
    <link rel="stylesheet" href="{{ pathPrefix }}assets/blog.css">
    <link rel="stylesheet" href="{{ pathPrefix }}assets/prism.css">
</head>
<body class="blog-body">
    <a class="blog-skip" href="#main">Skip to content</a>
    <div id="site-header"></div>
    <script src="{{ appRoot }}js/site-header.js"></script>

    <main id="main" class="blog-main" tabindex="-1">
        {{ content | safe }}
    </main>

    <div id="site-footer"></div>
    {%- if includeSearch %}
    <script src="{{ pathPrefix }}assets/search.js" defer></script>
    {%- endif %}
</body>
</html>
