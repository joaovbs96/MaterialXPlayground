# Allowlist: everything is excluded by `**` below except the `!` lines that
# follow. vsce excludes a file iff it matches an ignore pattern and no `!`
# pattern also matches it; `**` matches dotfiles too, so nothing needs listing.
**

!LICENSE
!CHANGELOG.md
!vscode_extension/MARKETPLACE.md
!vscode_extension/{src,media,language}/**
!favicon.ico
!apple-touch-icon.png
!environment_map.mtlx
!examples/**
!materials/**
!models/**
!env_maps/**
!libraries/**
!images/icon.png
!images/materialx-logo.svg
!images/tabler-icons/**
!js/*
!js/{docs,gen,graph,shared,vendor}/**
# USD Scene Viewer: the stage worker, its VS Code blob-linking shim, the
# glTF/OBJ loaders with their MaterialX converters, and the OpenUSD runtime
# (js/usd/index.js is a dev-only re-export).
!js/usd/usd-stage-loader.js
!js/usd/usd-stage-worker.js
!js/usd/usd-webview-worker-shim.js
!js/usd/gltf-stage-loader.js
!js/usd/obj-stage-loader.js
!js/usd/mtlx-material-docs.js
!js/materialx/LICENSE.txt
!js/materialx/1.39.5/JsMaterialXGenShader.js
!js/materialx/1.39.5/JsMaterialXGenShader.wasm
!js/materialx/1.39.5/JsMaterialXGenShader.data
!vendor/vendor-manifest.json
# BEGIN vendor-deps: generated by `npm run vendor` from scripts/vendor-deps.mjs (every dep without vscode: false), do not edit
!vendor/babel/**
!vendor/dagre/**
!vendor/highlightjs/**
!vendor/jszip/**
!vendor/katex/**
!vendor/pako/**
!vendor/react/**
!vendor/reactflow/**
!vendor/tailwind/**
!vendor/three/**
!vendor/usd-webview-bindings/**
!vendor/utif/**
# END vendor-deps
# vendor/materialx/ ships only what the webview/extension host reach:
# manifest, license, spec docs, one fallback material, plus the curated
# "New Material from Example" set. Keep in sync with check-vsix-files.mjs's MATERIALX_KEEP_LIST.
!vendor/materialx/manifest.json
!vendor/materialx/LICENSE
!vendor/materialx/documents/Specification/MaterialX.StandardNodes.md
!vendor/materialx/documents/Specification/MaterialX.PBRSpec.md
!vendor/materialx/documents/Specification/MaterialX.NPRSpec.md
!vendor/materialx/resources/Materials/Examples/OpenPbr/open_pbr_default.mtlx
!vendor/materialx/resources/Materials/Examples/StandardSurface/standard_surface_default.mtlx
!vendor/materialx/resources/Materials/Examples/StandardSurface/standard_surface_gold.mtlx
!vendor/materialx/resources/Materials/Examples/StandardSurface/standard_surface_glass.mtlx
!vendor/materialx/resources/Materials/Examples/StandardSurface/standard_surface_plastic.mtlx
!vendor/materialx/resources/Materials/Examples/StandardSurface/standard_surface_marble_solid.mtlx
!vendor/materialx/resources/Materials/Examples/OpenPbr/open_pbr_aluminum_brushed.mtlx
!vendor/materialx/resources/Materials/Examples/OpenPbr/open_pbr_glass.mtlx
!vendor/materialx/resources/Materials/Examples/OpenPbr/open_pbr_carpaint.mtlx
!vendor/materialx/resources/Materials/Examples/OpenPbr/open_pbr_velvet.mtlx
!vendor/materialx/resources/Materials/Examples/OpenPbr/open_pbr_pearl.mtlx
# Preset picker thumbnails: the release package job trims gallery/ down to
# exactly the example catalog's ids before packaging (see scripts/gallery-shots.mjs's
# --prune-ids). Original resolution, not resized; both files are optional
# (missing on a plain checkout, which falls back to letter placeholders).
!gallery/manifest.json
!gallery/thumbs/*.jpg
