# Allowlist: everything is excluded by `**` below except the `!` lines that
# follow. vsce excludes a file iff it matches an ignore pattern and no `!`
# pattern also matches it; `**` matches dotfiles too, so nothing needs listing.
**

!LICENSE
!CHANGELOG.md
!vscode_extension/MARKETPLACE.md
!vscode_extension/{src,media,language}/**
!favicon.ico
!apple-touch-icon.png
!environment_map.mtlx
!examples/**
!materials/**
# models/: listed by name, since vsce cannot re-exclude a `!` match; the About
# page's dragon (and its license) stays out, the About view is web and desktop only.
!models/{shaderball,shaderball_simple,shaderball_mtlx,cloth_base_mesh}.glb
!models/LICENSE_{shaderball,shaderball_mtlx,cloth}.txt
!env_maps/**
!libraries/**
!images/icon.png
!images/materialx-logo.svg
!images/tabler-icons/**
!js/*
!js/{docs,gen,graph,shared,vendor}/**
# USD Scene Viewer: the stage worker, its VS Code blob-linking shim, the
# glTF/OBJ/pbrt/Mitsuba loaders with their MaterialX converters, and the OpenUSD runtime
# (js/usd/index.js is a dev-only re-export).
!js/usd/usd-stage-loader.js
!js/usd/usd-stage-worker.js
!js/usd/usd-webview-worker-shim.js
!js/usd/gltf-stage-loader.js
!js/usd/obj-stage-loader.js
!js/usd/pbrt-stage-loader.js
!js/usd/mitsuba-stage-loader.js
!js/usd/scene-import-common.js
!js/usd/mtlx-material-docs.js
!js/usd/pfm-image.js
!js/materialx/LICENSE.txt
!js/materialx/1.39.5/JsMaterialXGenShader.js
!js/materialx/1.39.5/JsMaterialXGenShader.wasm
!js/materialx/1.39.5/JsMaterialXGenShader.data
!vendor/vendor-manifest.json
# BEGIN vendor-deps: generated by `npm run vendor` from scripts/vendor-deps.mjs (every dep without vscode: false), do not edit
!vendor/babel/**
!vendor/dagre/**
!vendor/highlightjs/**
!vendor/jszip/**
!vendor/katex/**
!vendor/pako/**
!vendor/react/**
!vendor/reactflow/**
!vendor/tailwind/**
!vendor/three/**
!vendor/usd-webview-bindings/**
!vendor/utif/**
!vendor/xml-formatter/**
!vendor/xml-parser-xo/**
# END vendor-deps
# vendor/materialx/ ships what the webview/extension host reach: manifest,
# license, spec docs, plus every .mtlx (root + any xi:include sibling) and
# every texture the full 54-material gallery references. This block is
# GENERATED from exampleCatalog.js's real catalog (manifest-driven) - see
# scripts/check-vsix-files.mjs's computeMaterialxKeepList(); never hand-add
# or hand-remove a line here. If check-vsix-files.mjs reports a MISSING or
# FORBIDDEN vendor/materialx path, regenerate this block from
# MATERIALX_KEEP_LIST instead of editing it by hand.
