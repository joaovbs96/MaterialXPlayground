.git/**
.claude/**
.vscode/**
.github/**
.gitignore
.gitattributes
node_modules/**
scripts/**
docs/**
tutorials-src/**
electron/**
package-lock.json
sitemap.xml
404.html
tutorial-ideas.md
images/og_image.png
images/preview-*.jpg

# Only the default MaterialX version ships in the .vsix — the Compare
# view (the only feature that needs extra versions) isn't in the
# webview nav. The default is computed in scripts/lib/mtlx-versions.mjs
# (DEFAULT_MTLX_VERSION); update this line if that ever changes.
js/materialx/1.39.4/**

# embed/ (the <materialx-viewer> web-embed bundle) is web-only: the
# webview skips it (js/shell.jsx VIEW_DEPS.graph.webviewSkip) since the
# Graph Editor's session preview never runs in VS Code.
embed/**

# Test suites and their configs never run inside the extension.
tests/**
playwright*.config.mjs
