*.py
# Exception: tutorials code-snippet sources are tracked — they're pulled into
# the docs via pymdownx snippets (check_paths: true), so a fresh clone must
# have them or the build fails.
!tutorials-src/snippets/*.py
node_modules/
vendor/materialx/
*.vsix

# Generated into the Pages artifact by deploy.yml at release time, never
# committed: a committed copy would serve a stale version locally. Kept out
# of js/** on purpose since the deterministic build id hashes js/** from disk.
/source-facts.json

# js/materialx/<version>/: only the default MaterialX version (see
# DEFAULT_MTLX_VERSION in scripts/lib/mtlx-versions.mjs) is committed to
# git. Every other pinned version is fetched on demand by
# `npm run vendor:versions` (scripts/fetch-mtlx-versions.mjs) and
# intentionally left out of the repo. Explicit per-version lines rather
# than a negation pattern — negation is fragile for directories.
js/materialx/1.39.4/

# Playwright output (npm run test:embed).
test-results/
playwright-report/

# docs/local/: scratch notes and internal write-ups that are for us only
# and deliberately not published. Anything in here is invisible to git,
# so nothing in it may be a build input or referenced by shipped docs.
docs/local/

# Generated by scripts/build-gallery.mjs + scripts/gallery-shots.mjs (npm
# run gallery:data): manifest + thumbnails, regenerated locally and at
# deploy time, never committed.
gallery/

# Regenerated by scripts/build-tutorials.mjs on every build; not the deploy artifact (that's /tutorials/).
tutorials-src/docs/assets/vendored/
# English-only search: Material's lunr language packs are pruned post-build (scripts/build-tutorials.mjs); backstop so they never get re-tracked.
tutorials/assets/javascripts/lunr/
tutorial-ideas.md
